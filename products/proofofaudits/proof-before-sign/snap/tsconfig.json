{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@metamask/snaps-sdk",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "alwaysStrict": true
  },
  "include": [
    "src/**/*",
    "dist/bundle.js",
    "../web/*.mjs",
    "package.json",
    "snap.manifest.json",
    "tsconfig.json"
  ],
  "exclude": [
    "node_modules"
  ]
}
